{
  "name": "arteche-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ARTECHE unified Cotizaciones + Bonos mobile application",
  "scripts": {
    "build:admob": "esbuild scripts/admob-entry.js --bundle --format=iife --platform=browser --target=es2020 --outfile=app/admob.bundle.js",
    "android:sync": "npm run build:admob && cap sync android",
    "android:open": "cap open android",
    "android:configure": "node scripts/configure-admob.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor-community/admob": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.25.0"
  }
}
